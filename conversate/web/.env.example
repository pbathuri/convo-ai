# D-ID — legacy Basic auth (email:secret base64) used server-side to resolve ck_ embed key
# Optional: set NEXT_PUBLIC_DID_CLIENT_KEY to ck_... from Studio embed directly
DID_API_BASIC_KEY=
NEXT_PUBLIC_DID_CLIENT_KEY=

# D-ID Agent ids (Studio → Agents → share link's `id=` param)
DID_PERSONA_AMAZON_L5=
DID_PERSONA_GOOGLE_L4=
DID_PERSONA_MCKINSEY_EM=
DID_PERSONA_GOLDMAN_VP=
DID_PERSONA_MSFT_PM=

# Upstash Redis (session + rate-limit storage). Sign up at upstash.com.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Dormant / V2 — D-ID LLM webhook override. Leave empty for V1.
GOOGLE_AI_STUDIO_KEY=

# Postgres (Supabase) — enable pgvector extension
DATABASE_URL=
# Direct connection for Prisma migrations (Supabase → Connection string → Direct)
DIRECT_URL=

# Admin mutation APIs (comma-separated emails)
ADMIN_EMAILS=dev@conversate.local

# Operational knobs
DID_DAILY_MINUTE_BUDGET=600
SESSION_COOKIE_SECRET=
