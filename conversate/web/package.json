    "db:reset": "prisma migrate reset --force",
    "kb:smoke": "tsx scripts/kb-smoke.ts",
    "test": "vitest run",
    "test:unit": "vitest run",
    "verify": "npm run build && npm run test && npm run kb:smoke && npm run demo:checklist",
    "demo:checklist": "tsx scripts/demo-checklist-smoke.ts",
    "test:e2e": "playwright test",
