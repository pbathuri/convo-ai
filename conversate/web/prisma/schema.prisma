generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [vector]
}

enum ApprovalStatus {
  pending
  approved
  rejected
}

enum RobotsStatus {
  allowed
  disallowed
  not_checked
}

enum AllowedUsage {
  ui_visible
  rag_only_no_display
  internal_only
  banned
}

enum PiiStatus {
  not_checked
  none
  masked
  contains_pii_blocked
}

enum LicenseStatus {
  public
  tos_allowed
  tos_restricted
  internal_use_only
  licensed
  unknown
}

enum SessionStatus {
  created
  preflight
  connecting
  live
  ending
  completed
  failed
  abandoned
}

enum InterviewMode {
  behavioral
  technical
  case
  mixed
}

enum Difficulty {
  easy
  medium
  hard
}

model UserProfile {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String?
  role      String   @default("candidate")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  sessions       Session[]
  consents       Consent[]
  skillSnapshots CandidateSkillSnapshot[]
  auditLogs      AuditLog[]               @relation("AuditActor")
}

model Consent {
  id            String   @id @default(cuid())
  userId        String
  user          UserProfile @relation(fields: [userId], references: [id], onDelete: Cascade)
  policyVersion String
  acceptedAt    DateTime @default(now())

  @@index([userId])
}

model Persona {
  id                    String   @id
  displayName           String
  companyName           String
  role                  String
  seniority             String
  didAgentEnvKey        String
  primaryRubricId       String?
  defaultDurationMinutes Int     @default(30)
  defaultDifficulty     Difficulty @default(medium)
  openingQuestion       String?
  candidateInstructions String?
  forbiddenBehavior     String?
  fallbackBehavior      String?
  interviewModes        InterviewMode[]
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  versions       PersonaVersion[]
  sessions       Session[]
  skillSnapshots CandidateSkillSnapshot[]
}

model PersonaVersion {
  id             String   @id @default(cuid())
  personaId      String
  persona        Persona  @relation(fields: [personaId], references: [id], onDelete: Cascade)
  promptVersion  String
  kbVersionId    String?
  rubricVersion  String
  verifiedAt     DateTime?
  createdAt      DateTime @default(now())

  @@index([personaId, createdAt])
}

model Session {
  id              String        @id @default(cuid())
  userId          String?
  user            UserProfile?  @relation(fields: [userId], references: [id])
  personaId       String
  persona         Persona       @relation(fields: [personaId], references: [id])
  status          SessionStatus @default(created)
  interviewMode   InterviewMode @default(behavioral)
  difficulty      Difficulty    @default(medium)
  kbVersionId     String?
  rubricVersion   String?
  promptVersion   String?
  startedAt       DateTime?
  endedAt         DateTime?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  messages         Message[]
  scores           Score[]
  modelRuns        ModelRun[]
  feedbackRatings  FeedbackRating[]
  costEvents       CostEvent[]

  @@index([userId, createdAt])
  @@index([personaId, createdAt])
}

model Message {
  id        String   @id @default(cuid())
  sessionId String
  session   Session  @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  role      String
  content   String
  sequence  Int
  createdAt DateTime @default(now())

  @@index([sessionId, sequence])
}

model Rubric {
  id        String   @id @default(cuid())
  personaId String
  version   String
  dimensions Json
  createdAt DateTime @default(now())
}

model Score {
  id            String   @id @default(cuid())
  sessionId     String
  session       Session  @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  personaId     String
  rubricVersion String
  overallScore  Float
  dimensions    Json
  strengths     Json
  weaknesses    Json
  actionItems   Json
  evidence      Json
  confidence    Float?
  createdAt     DateTime @default(now())
  modelRuns     ModelRun[]

  @@index([sessionId])
}

model ModelRun {
  id             String   @id @default(cuid())
  sessionId      String
  session        Session  @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  scoreId        String?
  score          Score?   @relation(fields: [scoreId], references: [id])
  personaId      String
  modelProvider  String
  modelName      String
  rubricVersion  String
  kbVersion      String?
  inputHash      String
  outputJson     Json
  confidence     Float?
  latencyMs      Int?
  costUsd        Float?
  retrievalTrace Json?
  createdAt      DateTime @default(now())

  @@index([sessionId])
}

model KbSource {
  id              String         @id @default(cuid())
  sourceUrl       String?
  sourceType      String
  captureMethod   String
  licenseStatus   LicenseStatus  @default(unknown)
  robotsStatus    RobotsStatus   @default(not_checked)
  allowedUsage    AllowedUsage   @default(internal_only)
  piiStatus       PiiStatus      @default(not_checked)
  approvalStatus  ApprovalStatus @default(pending)
  reviewedBy      String?
  reviewedAt      DateTime?
  retentionPolicy String?
  createdAt       DateTime       @default(now())

  documents KbDocument[]
  chunks    KbChunk[]

  @@index([approvalStatus, sourceType])
}

model KbDocument {
  id        String   @id @default(cuid())
  sourceId  String
  source    KbSource @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  title     String?
  rawText   String?
  createdAt DateTime @default(now())

  chunks KbChunk[]
}

model KbChunk {
  id             String         @id @default(cuid())
  documentId     String
  document       KbDocument     @relation(fields: [documentId], references: [id], onDelete: Cascade)
  sourceId       String
  source         KbSource       @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  personaId      String?
  kbVersionId    String?
  kbVersion      KbVersion?     @relation(fields: [kbVersionId], references: [id])
  content        String
  metadata       Json?
  approvalStatus ApprovalStatus @default(pending)
  qualityScore   Float?
  createdAt      DateTime       @default(now())

  @@index([personaId, approvalStatus])
  @@index([kbVersionId])
}

model KbVersion {
  id        String   @id @default(cuid())
  personaId String
  label     String
  isActive  Boolean  @default(false)
  createdAt DateTime @default(now())

  chunks KbChunk[]
}

model ScraperRun {
  id        String   @id @default(cuid())
  status    String
  source    String?
  startedAt DateTime @default(now())
  endedAt   DateTime?
  manifest  Json?

  items ScraperItem[]
}

model ScraperItem {
  id           String     @id @default(cuid())
  scraperRunId String
  scraperRun   ScraperRun @relation(fields: [scraperRunId], references: [id], onDelete: Cascade)
  sourceUrl    String?
  status       String
  rawMeta      Json?
}

model FeedbackRating {
  id        String   @id @default(cuid())
  sessionId String
  session   Session  @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  rating    Int
  comment   String?
  createdAt DateTime @default(now())
}

model CostEvent {
  id        String   @id @default(cuid())
  sessionId String?
  session   Session? @relation(fields: [sessionId], references: [id])
  provider  String
  amountUsd Float
  units     Float?
  meta      Json?
  createdAt DateTime @default(now())

  @@index([createdAt, provider])
}

model AuditLog {
  id        String   @id @default(cuid())
  actorId   String?
  actor     UserProfile? @relation("AuditActor", fields: [actorId], references: [id])
  action    String
  target    String?
  diff      Json?
  createdAt DateTime @default(now())

  @@index([createdAt, actorId])
}

model CandidateSkillSnapshot {
  id            String   @id @default(cuid())
  userId        String
  user          UserProfile @relation(fields: [userId], references: [id], onDelete: Cascade)
  personaId     String
  persona       Persona  @relation(fields: [personaId], references: [id], onDelete: Cascade)
  skillName     String
  rollingScore  Float
  sessionCount  Int
  lastSessionId String?
  updatedAt     DateTime @updatedAt

  @@unique([userId, personaId, skillName])
}
