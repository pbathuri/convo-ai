# Corpus root (external drive). Must exist and be writable before init/scrape.
CORPUS_ROOT=/Volumes/My Passport/Convo-Ai

# Logging
LOG_LEVEL=INFO

# Reddit (optional — if unset, fixture fallback is used for smoke tests)
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=convo-ai-scraper/0.1
